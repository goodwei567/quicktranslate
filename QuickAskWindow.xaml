<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="QuickTranslate.QuickAskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:QuickTranslate.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="快速提问 - QuickTranslate">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent"
          PreviewKeyDown="RootGrid_PreviewKeyDown" SizeChanged="RootGrid_SizeChanged"
          ActualThemeChanged="RootGrid_ActualThemeChanged">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="PopupAccentBrush" Color="#0A5FC2" />
                        <SolidColorBrush x:Key="PopupAccentFillBrush" Color="#E6EEFB" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="PopupAccentBrush" Color="#7CB8FF" />
                        <SolidColorBrush x:Key="PopupAccentFillBrush" Color="#1B3554" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="PopupAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                        <SolidColorBrush x:Key="PopupAccentFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="PopupTitleBar" Title="快速提问" Height="38">
            <TitleBar.IconSource>
                <FontIconSource Glyph="&#xE8BD;" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="MetadataRow" Grid.Row="1" Margin="16,0,16,10" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="直接提问，不读取选区" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="NewConversationButton" Content="新对话"
                        Style="{StaticResource QtQuietButtonStyle}"
                        HorizontalAlignment="Right" Click="NewConversationButton_Click"
                        ToolTipService.ToolTip="清空当前对话并开始新的提问" />
            </Grid>
            <Border Grid.Row="1" Background="{ThemeResource QtFieldBrush}"
                    BorderBrush="{ThemeResource QtCardStrokeBrush}" BorderThickness="1"
                    CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ModelComboBox" MinHeight="30" MaxDropDownHeight="320"
                              HorizontalAlignment="Stretch"
                              Style="{StaticResource QtBorderlessComboBoxStyle}"
                              DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"
                              SelectionChanged="ModelComboBox_SelectionChanged"
                              AutomationProperties.Name="Magpie 模型"
                              ToolTipService.ToolTip="与工作台共享模型；在这里切换会立即保存" />
                    <Button x:Name="RefreshModelsButton" Grid.Column="1" Width="28" Height="28"
                            Margin="0,0,3,0" VerticalAlignment="Center"
                            Style="{StaticResource QtQuietIconButtonStyle}"
                            Click="RefreshModels_Click" ToolTipService.ToolTip="刷新 Magpie 模型列表"
                            AutomationProperties.Name="刷新模型">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="BodyScroller" Padding="16,0,16,14" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                          IsHorizontalRailEnabled="False" IsVerticalScrollChainingEnabled="False"
                          ViewChanged="BodyScroller_ViewChanged" AutomationProperties.Name="提问记录">
                <StackPanel>
                    <StackPanel x:Name="EmptyStatePanel" Spacing="6" Margin="0,44,0,0" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE8BD;" FontSize="26" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource PopupAccentBrush}" />
                        <TextBlock Text="问点什么" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="输入问题后按 Enter，回答会流式显示在这里。"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ItemsControl x:Name="ConversationItems" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ConversationTurn">
                                <StackPanel Margin="0,0,0,18">
                                    <Border HorizontalAlignment="Right" Margin="28,0,0,0" Padding="11,8"
                                            CornerRadius="12,12,3,12" Background="{ThemeResource PopupAccentFillBrush}">
                                        <TextBlock Text="{x:Bind Question}" FontSize="13" LineHeight="20" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </Border>
                                    <TextBlock Text="QuickTranslate" FontSize="10" Margin="0,10,0,4"
                                               Foreground="{ThemeResource PopupAccentBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind LoadingVisibility, Mode=OneWay}">
                                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsPending, Mode=OneWay}"
                                                      Foreground="{ThemeResource PopupAccentBrush}" />
                                        <TextBlock Text="正在思考…" FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <controls:MarkdownTextBlock Text="{x:Bind Answer, Mode=OneWay}" FontSize="14"
                                                                IsTextSelectionEnabled="True"
                                                                UsePipeTables="True" UseTaskLists="True"
                                                                UseAutoLinks="True" DisableHtml="True" />
                                    <StackPanel Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" Spacing="4">
                                        <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <HyperlinkButton Content="重新发送" FontSize="13" Padding="0,4"
                                                         Click="RetryQuestionButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="LatestButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,12"
                    Visibility="Collapsed" Click="LatestButton_Click" ToolTipService.ToolTip="滚动到最新回答">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                    <TextBlock Text="最新" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="ComposerBorder" Grid.Row="3" Padding="16,10,16,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="Transparent">
            <StackPanel Spacing="8">
                <InfoBar x:Name="AskErrorBar" IsOpen="False" IsClosable="True" Severity="Warning" Margin="0,0,0,2" />
                <Grid>
                    <Border Background="{ThemeResource QtFieldBrush}"
                            BorderBrush="{ThemeResource QtCardStrokeBrush}" BorderThickness="1"
                            CornerRadius="12" />
                    <Grid Padding="5,4,5,4" ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="QuestionTextBox" PlaceholderText="问点什么…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="120"
                                 Style="{StaticResource QtComposerTextBoxStyle}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 GotFocus="QuestionTextBox_GotFocus"
                                 LostFocus="QuestionTextBox_LostFocus"
                                 TextChanged="QuestionTextBox_TextChanged"
                                 PreviewKeyDown="QuestionTextBox_PreviewKeyDown"
                                 TextCompositionStarted="QuestionTextBox_TextCompositionStarted"
                                 TextCompositionEnded="QuestionTextBox_TextCompositionEnded"
                                 AutomationProperties.Name="自由提问输入框">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="CancelButton" Height="44" MinWidth="48"
                                    Style="{StaticResource QtQuietButtonStyle}"
                                    Content="取消" Visibility="Collapsed"
                                    Click="CancelButton_Click" ToolTipService.ToolTip="取消当前回答" />
                            <Button x:Name="SendButton" Width="44" Height="44" Padding="0"
                                    CornerRadius="22" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                                    Click="SendButton_Click"
                                    AutomationProperties.Name="发送问题" ToolTipService.ToolTip="发送（Enter）">
                                <FontIcon Glyph="&#xE724;" FontSize="15" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ComposerFocusRing" IsHitTestVisible="False"
                            Background="Transparent"
                            BorderBrush="{ThemeResource PopupAccentBrush}" BorderThickness="1"
                            CornerRadius="12" Opacity="0" />
                </Grid>
                <Grid>
                    <TextBlock Text="Enter 发送 · Shift+Enter 换行" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="Esc 隐藏" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
