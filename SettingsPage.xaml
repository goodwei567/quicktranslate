<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QuickTranslate.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel MaxWidth="780" Padding="22,16,22,32" Spacing="14" HorizontalAlignment="Stretch">
            <StackPanel Spacing="5">
                <TextBlock Text="设置" Style="{StaticResource QtPageTitleStyle}" />
                <TextBlock Text="调整快捷键、任务提示词、后台行为与本地数据选项。"
                           Style="{StaticResource QtCaptionStyle}" />
            </StackPanel>

            <StackPanel Spacing="14">
                <Border Style="{StaticResource QtCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="启动与后台运行" Style="{StaticResource QtSectionTitleStyle}" />
                            <TextBlock Text="应用需要保持运行，全局快捷键才能随时响应。"
                                       Style="{StaticResource QtCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="开机启动" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="登录 Windows 后在托盘后台运行，不主动弹出主窗口。Magpie 仍需单独启动。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartWithWindowsToggle" Grid.Column="1"
                                          Style="{StaticResource QtSettingsToggleStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="关闭后缩小到托盘" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="点击主窗口的关闭按钮时只隐藏窗口，快捷键继续可用。关闭此项后，关闭按钮会直接退出。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1"
                                          Style="{StaticResource QtSettingsToggleStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Spacing="3" Margin="0,1,0,0">
                            <TextBlock x:Name="StartupStatusTextBlock" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" Foreground="{ThemeResource QtSecondaryTextBrush}" />
                            <TextBlock Text="托盘图标可重新打开主窗口；开机启动绑定当前程序位置，移动程序后请重新保存设置。"
                                       FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                       Foreground="{ThemeResource QtSecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QtCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="管理员模式" Style="{StaticResource QtSectionTitleStyle}" />
                            <TextBlock Text="仅用于读取以管理员权限运行的窗口。普通窗口始终可用。"
                                       Style="{StaticResource QtCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="以管理员权限运行" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="保存后会请求一次 UAC 并重启。若同时开启开机启动，将使用最高权限计划任务。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AdministratorModeToggle" Grid.Column="1"
                                          Style="{StaticResource QtSettingsToggleStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="遇到管理员窗口时自动切换" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="检测到目标窗口权限更高时请求 UAC；取消后仍保持普通权限。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="AutoElevateToggle" Grid.Column="1"
                                          Style="{StaticResource QtSettingsToggleStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ElevationStatusTextBlock" VerticalAlignment="Center" FontSize="11"
                                       LineHeight="16" TextWrapping="Wrap"
                                       Foreground="{ThemeResource QtSecondaryTextBrush}" />
                            <Button x:Name="RestartElevatedButton" Grid.Column="1" Content="以管理员权限重启"
                                    Style="{StaticResource QtPillButtonStyle}" Click="RestartElevatedButton_Click" />
                        </Grid>
                        <TextBlock Text="安全说明：QuickTranslate 不绕过 UAC，也不会创建额外的提权后台服务。管理员模式只提高当前程序权限。"
                                   FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                   Foreground="{ThemeResource QtSecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QtCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="快捷键" Style="{StaticResource QtSectionTitleStyle}" />
                            <TextBlock Text="划词助手读取当前选区；自由提问直接打开输入框。两个快捷键不能相同。"
                                       Style="{StaticResource QtCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="划词助手" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="选中文字后打开翻译窗口，并自动读取选区。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="10,4" CornerRadius="8"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource QtSegmentTrackBrush}">
                                <TextBlock x:Name="HotkeyPreviewTextBlock" FontSize="12" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ToggleButton x:Name="ControlCheckBox" Content="Ctrl"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="HotkeyChoice_Changed" Unchecked="HotkeyChoice_Changed" />
                                <ToggleButton x:Name="AltCheckBox" Content="Alt"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="HotkeyChoice_Changed" Unchecked="HotkeyChoice_Changed" />
                                <ToggleButton x:Name="ShiftCheckBox" Content="Shift"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="HotkeyChoice_Changed" Unchecked="HotkeyChoice_Changed" />
                                <ToggleButton x:Name="WindowsCheckBox" Content="Win"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="HotkeyChoice_Changed" Unchecked="HotkeyChoice_Changed" />
                            </StackPanel>
                            <ComboBox x:Name="HotkeyKeyComboBox" Grid.Column="1" MinWidth="150"
                                      MaxDropDownHeight="300" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="HotkeyKeyComboBox_SelectionChanged"
                                      AutomationProperties.Name="划词助手主键" />
                            <Button x:Name="ResetHotkeyButton" Grid.Column="2" Content="恢复默认"
                                    Style="{StaticResource QtPillButtonStyle}" Click="ResetHotkey_Click" />
                        </Grid>
                        <TextBlock x:Name="ActiveHotkeyTextBlock" FontSize="11" LineHeight="16"
                                   TextWrapping="Wrap" Foreground="{ThemeResource QtSecondaryTextBrush}" />

                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="自由提问" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="不读取选区，立即打开一个可自由提问和追问的输入框。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="10,4" CornerRadius="8"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource QtSegmentTrackBrush}">
                                <TextBlock x:Name="AskHotkeyPreviewTextBlock" FontSize="12" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ToggleButton x:Name="AskControlCheckBox" Content="Ctrl"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="AskHotkeyChoice_Changed" Unchecked="AskHotkeyChoice_Changed" />
                                <ToggleButton x:Name="AskAltCheckBox" Content="Alt"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="AskHotkeyChoice_Changed" Unchecked="AskHotkeyChoice_Changed" />
                                <ToggleButton x:Name="AskShiftCheckBox" Content="Shift"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="AskHotkeyChoice_Changed" Unchecked="AskHotkeyChoice_Changed" />
                                <ToggleButton x:Name="AskWindowsCheckBox" Content="Win"
                                              Style="{StaticResource QtModifierChipStyle}"
                                              Checked="AskHotkeyChoice_Changed" Unchecked="AskHotkeyChoice_Changed" />
                            </StackPanel>
                            <ComboBox x:Name="AskHotkeyKeyComboBox" Grid.Column="1" MinWidth="150"
                                      MaxDropDownHeight="300" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectionChanged="AskHotkeyKeyComboBox_SelectionChanged"
                                      AutomationProperties.Name="自由提问主键" />
                            <Button x:Name="ResetAskHotkeyButton" Grid.Column="2" Content="恢复默认"
                                    Style="{StaticResource QtPillButtonStyle}" Click="ResetAskHotkey_Click" />
                        </Grid>
                        <TextBlock x:Name="ActiveAskHotkeyTextBlock" FontSize="11" LineHeight="16"
                                   TextWrapping="Wrap" Foreground="{ThemeResource QtSecondaryTextBrush}" />
                        <TextBlock Text="若快捷键被其他程序占用，保存时会提示；原快捷键不会被停用。"
                                   FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                   Foreground="{ThemeResource QtSecondaryTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QtCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="提示词与任务" Style="{StaticResource QtSectionTitleStyle}" />
                            <TextBlock Text="主页面、划词弹窗和自由提问共用这一份任务设定。"
                                       Style="{StaticResource QtCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="任务预设" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="选择翻译、解释、总结，或自定义处理方式。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="PromptPresetComboBox" Grid.Column="1" MinWidth="170"
                                      VerticalAlignment="Center"
                                      SelectionChanged="PromptPresetComboBox_SelectionChanged">
                                <ComboBoxItem Content="翻译" Tag="translation" />
                                <ComboBoxItem Content="技术文档" Tag="technical" />
                                <ComboBoxItem Content="解释文字" Tag="explanation" />
                                <ComboBoxItem Content="总结要点" Tag="summary" />
                                <ComboBoxItem Content="自定义" Tag="custom" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="提示词内容" Style="{StaticResource QtSettingsRowLabelStyle}" />
                            <TextBox x:Name="TaskPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="150" MaxHeight="280" MaxLength="12000" Padding="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     TextChanged="TaskPromptBox_TextChanged"
                                     PlaceholderText="例如：请用通俗的语言解释这段文字，说明关键概念，并给出一个例子。" />
                            <TextBlock Text="使用 {language} 引用目标语言。选中文字会自动附加，无需手动填写；修改提示词后，原文会按新任务重新处理。"
                                       FontSize="11" LineHeight="16" TextWrapping="Wrap"
                                       Foreground="{ThemeResource QtSecondaryTextBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QtCardStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="翻译体验" Style="{StaticResource QtSectionTitleStyle}" />
                            <TextBlock Text="控制输出方式、本地缓存和历史记录。所有数据只保存在本机。"
                                       Style="{StaticResource QtCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="流式输出" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock Text="生成时逐步显示结果；请求过程中可以随时取消。"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StreamingToggle" Grid.Column="1"
                                          Style="{StaticResource QtSettingsToggleStyle}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="本地翻译缓存" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock x:Name="CacheStatusTextBlock"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <ToggleSwitch x:Name="TranslationCacheToggle"
                                              Style="{StaticResource QtSettingsToggleStyle}" />
                                <Button x:Name="ClearCacheButton" Content="清空"
                                        Style="{StaticResource QtPillButtonStyle}" Click="ClearCache_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource QtSettingsDividerStyle}" />

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="保存翻译历史" Style="{StaticResource QtSettingsRowLabelStyle}" />
                                <TextBlock x:Name="HistoryStatusTextBlock"
                                           Style="{StaticResource QtSettingsRowDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="TranslationHistoryToggle" Grid.Column="1"
                                          Style="{StaticResource QtSettingsToggleStyle}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最多保留" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource QtSecondaryTextBrush}" />
                            <ComboBox x:Name="HistoryLimitComboBox" Grid.Column="1" MinWidth="120">
                                <ComboBoxItem Content="50 条" Tag="50" />
                                <ComboBoxItem Content="100 条" Tag="100" />
                                <ComboBoxItem Content="200 条" Tag="200" />
                                <ComboBoxItem Content="500 条" Tag="500" />
                            </ComboBox>
                            <Button x:Name="ClearHistoryButton" Grid.Column="3" Content="清空历史"
                                    Style="{StaticResource QtPillButtonStyle}" Click="ClearHistory_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="14,11" CornerRadius="10"
                        Background="{ThemeResource QtSegmentTrackBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"
                                  Foreground="{ThemeResource QtSecondaryTextBrush}" />
                        <TextBlock Grid.Column="1" FontSize="12" LineHeight="17" TextWrapping="Wrap"
                                   Foreground="{ThemeResource QtSecondaryTextBrush}"
                                   Text="划词窗口始终置顶，默认出现在当前屏幕右上角；也可以拖动和调整大小。" />
                    </Grid>
                </Border>

                <Grid>
                    <Button x:Name="SaveSettingsButton" Content="保存并应用"
                            Style="{StaticResource AccentButtonStyle}" MinWidth="118"
                            HorizontalAlignment="Right" Click="SaveSettings_Click" />
                </Grid>

                <InfoBar x:Name="SettingsStatusBar" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
