<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QuickTranslate.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickTranslate.Controls"
    xmlns:models="using:QuickTranslate.Models">
    <Grid Padding="20,14,20,28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="历史记录" Style="{StaticResource QtPageTitleStyle}" />
                <TextBlock x:Name="HistorySubtitleTextBlock" Style="{StaticResource QtCaptionStyle}" />
            </StackPanel>
            <Button x:Name="ClearAllHistoryButton" Grid.Column="1" Content="清空历史"
                    Style="{StaticResource QtPillButtonStyle}" VerticalAlignment="Center" Click="ClearAllHistory_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="搜索原文、结果或模型…"
                     TextChanged="SearchBox_TextChanged" Width="300" Height="32"
                     HorizontalAlignment="Left" VerticalAlignment="Center" />
            <controls:SegmentButton x:Name="FavoritesOnlyToggle" Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource QtSegmentButtonStyle}"
                                    Background="{ThemeResource QtSegmentTrackBrush}"
                                    MinHeight="32" MinWidth="104" Padding="12,4" CornerRadius="9"
                                    Click="FavoritesOnlyToggle_Click"
                                    ToolTipService.ToolTip="只显示已收藏的记录">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE734;" FontSize="12" />
                    <TextBlock Text="只看收藏" FontSize="13" />
                </StackPanel>
            </controls:SegmentButton>
        </Grid>

        <InfoBar x:Name="HistoryStatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="3">
            <ListView x:Name="HistoryList" SelectionMode="None" IsItemClickEnabled="False" Padding="0,2,0,8"
                      VerticalAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TranslationHistoryEntry">
                        <Border Padding="18" CornerRadius="10"
                                Background="{ThemeResource QtCardBrush}"
                                BorderBrush="{ThemeResource QtCardStrokeBrush}" BorderThickness="1">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{x:Bind MetaText}" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind SourcePreview}" FontSize="15" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <TextBlock Text="{x:Bind ResultPreview}" FontSize="13" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxLines="3"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Top">
                                    <Button Content="{x:Bind FavoriteGlyph}" Tag="{x:Bind Id}"
                                            Click="ToggleFavorite_Click" MinWidth="34" MinHeight="28"
                                            ToolTipService.ToolTip="{x:Bind FavoriteLabel}" />
                                    <Button Content="查看" Tag="{x:Bind Id}" MinHeight="28" Click="ViewEntry_Click" />
                                    <Button Content="复制" Tag="{x:Bind Id}" MinHeight="28" Click="CopyEntry_Click" />
                                    <Button Content="删除" Tag="{x:Bind Id}" MinHeight="28" Click="DeleteEntry_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE81C;" FontSize="34" Opacity="0.45" />
                <TextBlock Text="还没有匹配的翻译记录" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyHintTextBlock" Text="开启“保存翻译历史”后，完成的划词和手动处理会出现在这里。"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
