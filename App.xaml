<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="QuickTranslate.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickTranslate">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/MacTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Softer, smaller radii across every control for a less blocky look. -->
            <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
