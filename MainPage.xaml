<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QuickTranslate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid MaxWidth="720" Padding="20,14,20,28" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="QuickTranslate" Style="{StaticResource QtPageTitleStyle}" />
                <TextBlock x:Name="ShortcutHintTextBlock" Style="{StaticResource QtCaptionStyle}" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource QtCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Magpie 连接" Style="{StaticResource QtSectionTitleStyle}" />
                    <TextBlock Style="{StaticResource QtCaptionStyle}"
                               Text="连接本机 Magpie，不需要 API Key；模型与额度取决于 Magpie 的配置，选中文本会发送给所选模型提供方。" />
                    <TextBox x:Name="BaseUrlBox" Header="Magpie API 地址" Text="http://127.0.0.1:3425/v1" PlaceholderText="http://127.0.0.1:3425/v1" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelComboBox" Header="Magpie 模型" MinWidth="220" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="DisplayLabel" SelectedValuePath="Id"
                                  SelectionChanged="ModelComboBox_SelectionChanged" />
                        <Button x:Name="RefreshModelsButton" Grid.Column="1" Margin="0,24,0,0" Content="刷新模型"
                                Style="{StaticResource QtPillButtonStyle}" Click="RefreshModels_Click" />
                        <ComboBox x:Name="TargetLanguageBox" Grid.Column="2" Header="目标语言"
                                  MinWidth="120" MaxDropDownHeight="320" HorizontalAlignment="Stretch"
                                  SelectionChanged="TargetLanguageBox_SelectionChanged" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ReasoningEffortComboBox" Header="思考强度（按模型）"
                                  MinWidth="180" HorizontalAlignment="Left"
                                  SelectionChanged="ReasoningEffortComboBox_SelectionChanged">
                            <ComboBoxItem Content="默认（不发送）" Tag="" />
                            <ComboBoxItem Content="低" Tag="low" />
                            <ComboBoxItem Content="中" Tag="medium" />
                            <ComboBoxItem Content="高" Tag="high" />
                        </ComboBox>
                        <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,7"
                                   Style="{StaticResource QtCaptionStyle}"
                                   Text="默认不发送思考参数；上下文长度和输出上限完全交给 Magpie 与所选模型。若模型不支持所选强度，会自动按默认值重试一次。" />
                    </Grid>
                    <TextBlock Text="目标语言即时同步并自动保存；连接和模型设置仍需点击保存设置。"
                               Style="{StaticResource QtCaptionStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="保存设置" Style="{StaticResource QtPillButtonStyle}" Click="SaveSettings_Click" />
                        <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Style="{StaticResource QtCaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource QtCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ManualTaskTitleTextBlock" Text="手动处理" Style="{StaticResource QtSectionTitleStyle}" />
                    <TextBlock x:Name="TaskHintTextBlock" Style="{StaticResource QtCaptionStyle}" />
                    <TextBox x:Name="SourceTextBox" Header="原文" PlaceholderText="输入一段文字，或用设置中的快捷键读取选中文字"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TranslateButton" Content="翻译" Style="{StaticResource QtPillButtonStyle}" Click="TranslateButton_Click" />
                        <Button x:Name="CancelManualTranslationButton" Content="取消"
                                Style="{StaticResource QtPillButtonStyle}"
                                Click="CancelManualTranslationButton_Click" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ResultHeaderTextBlock" Text="译文" FontSize="13" FontWeight="SemiBold" />
                        <Border MinHeight="80" Padding="12" CornerRadius="10"
                                Background="{ThemeResource QtFieldBrush}"
                                BorderBrush="{ThemeResource QtCardStrokeBrush}" BorderThickness="1">
                            <controls:MarkdownTextBlock x:Name="ResultTextBox" FontSize="14"
                                                        IsTextSelectionEnabled="True"
                                                        UsePipeTables="True" UseTaskLists="True"
                                                        UseAutoLinks="True" DisableHtml="True" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusBar" Grid.Row="3" Margin="0,12,0,0" IsOpen="False" />
        </Grid>
    </ScrollViewer>
</Page>
