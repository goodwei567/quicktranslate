<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="QuickTranslate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid MaxWidth="980" Padding="32,28,32,48" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="QuickTranslate" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Name="ShortcutHintTextBlock" Opacity="0.72" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,28,0,0" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Magpie 连接" FontSize="20" FontWeight="SemiBold" />
                    <InfoBar IsOpen="True" Severity="Informational" Title="复用 Magpie" Message="本应用连接 Magpie 本机 API，不需要另填 API Key。模型及其费用/额度取决于你在 Magpie 中的配置。选中文本会发送给所选模型提供方。" />
                    <TextBox x:Name="BaseUrlBox" Header="Magpie API 地址" Text="http://127.0.0.1:3425/v1" PlaceholderText="http://127.0.0.1:3425/v1" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelComboBox" Header="Magpie 模型" MinWidth="260" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayLabel" SelectedValuePath="Id" />
                        <Button x:Name="RefreshModelsButton" Grid.Column="1" Margin="0,25,0,0" Content="刷新模型" Click="RefreshModels_Click" />
                        <ComboBox x:Name="TargetLanguageBox" Grid.Column="2" Header="目标语言"
                                  MinWidth="120" MaxDropDownHeight="320" HorizontalAlignment="Stretch"
                                  SelectionChanged="TargetLanguageBox_SelectionChanged" />
                    </Grid>
                    <TextBlock Text="目标语言即时同步并自动保存；连接和模型设置仍需点击保存设置。"
                               FontSize="12" Opacity="0.72" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="保存设置" Click="SaveSettings_Click" />
                        <TextBlock x:Name="SaveStatusText" VerticalAlignment="Center" Opacity="0.72" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,20,0,0" Padding="24" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="ManualTaskTitleTextBlock" Text="手动处理" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaskHintTextBlock" FontSize="12" TextWrapping="Wrap" Opacity="0.72" />
                    <TextBox x:Name="SourceTextBox" Header="原文" PlaceholderText="输入一段文字，或用设置中的快捷键读取选中文字" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" />
                    <Button x:Name="TranslateButton" Content="翻译" Click="TranslateButton_Click" HorizontalAlignment="Left" />
                    <TextBox x:Name="ResultTextBox" Header="译文" IsReadOnly="True" TextWrapping="Wrap" MinHeight="112" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusBar" Grid.Row="3" Margin="0,20,0,0" IsOpen="False" />
        </Grid>
    </ScrollViewer>
</Page>
