<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:QuickTranslate.Controls">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="QtCardBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="QtCardStrokeBrush" Color="#17000000" />
            <SolidColorBrush x:Key="QtSegmentTrackBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="QtSegmentSelectedBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="QtSegmentHoverBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="QtSegmentPressedBrush" Color="#33000000" />
            <SolidColorBrush x:Key="QtChromeBrush" Color="#CCF5F5F7" />
            <SolidColorBrush x:Key="QtSecondaryTextBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="QtFieldBrush" Color="#99FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="QtCardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="QtCardStrokeBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="QtSegmentTrackBrush" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="QtSegmentSelectedBrush" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="QtSegmentHoverBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="QtSegmentPressedBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="QtChromeBrush" Color="#CC1C1C1E" />
            <SolidColorBrush x:Key="QtSecondaryTextBrush" Color="#98989D" />
            <SolidColorBrush x:Key="QtFieldBrush" Color="#14FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="QtCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QtCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QtSegmentTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QtSegmentSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="QtSegmentHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QtSegmentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="QtChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="QtSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="QtFieldBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Compact macOS-like type ramp: small titles, quiet captions. -->
    <Style x:Key="QtPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="QtSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="QtCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource QtSecondaryTextBrush}" />
    </Style>

    <Style x:Key="QtCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource QtCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource QtCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="QtPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="QtFieldBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Segmented switcher used as the app navigation, echoing macOS toolbar segments.
         Selection and hover are painted by the control, because template VisualState
         setters do not revert once the state is left. -->
    <Style x:Key="QtSegmentButtonStyle" TargetType="controls:SegmentButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="11,2" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SegmentButton">
                    <Border x:Name="SegmentRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="0">
                        <Grid>
                            <Border x:Name="HoverLayer" CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False" />
                            <Border x:Name="CheckLayer" CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="FocusRing" Margin="-2" CornerRadius="9"
                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                    BorderBrush="{ThemeResource FocusStrokeColorOuterBrush}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
